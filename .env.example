# Copia in .env.local e riempi. .env.local non entra in git.
# Contratto completo e regole: docs/ENVIRONMENT.md
# Nessuna chiave segreta può portare il prefisso NEXT_PUBLIC_.

# --- Client, pubbliche ---
NEXT_PUBLIC_SUPABASE_URL=https://progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_chiave_anon_finta
NEXT_PUBLIC_LIVEKIT_URL=wss://progetto.livekit.cloud
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server, segrete: bypassano RLS o costano soldi ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi_service_role_finta

# Firma il cookie dell'ospite senza account. Genera con: openssl rand -hex 32
GUEST_SESSION_SECRET=sostituisci_con_64_caratteri_esadecimali_casuali_0000000000000000

LIVEKIT_API_KEY=API_chiave_finta
LIVEKIT_API_SECRET=segreto_finto

# STT: la chiave resta server-side. Il server emette token a vita breve
# che il browser usa per parlare col vendor (ADR-0006).
DEEPGRAM_API_KEY=finta

ANTHROPIC_API_KEY=sk-ant-finta
# 'anthropic' in preview e produzione; 'fake' in sviluppo, CI ed e2e (nessun costo).
AI_PROVIDER=fake
OPENAI_API_KEY=sk-finta
FAL_KEY=finta

R2_ACCOUNT_ID=finto
R2_ACCESS_KEY_ID=finto
R2_SECRET_ACCESS_KEY=finto
R2_BUCKET=omnicanvas-assets

KV_REST_API_URL=https://finto.upstash.io
KV_REST_API_TOKEN=finto

# --- Post-MVP, billing ---
STRIPE_SECRET_KEY=sk_test_finta
STRIPE_WEBHOOK_SECRET=whsec_finto

# --- Job di purga ---
CRON_SECRET=stringa_casuale_lunga
