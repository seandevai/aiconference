{
  "name": "omnicanvas",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "memory": "8gb"
  },
  "forwardPorts": [3000, 54321, 54323, 54324],
  "portsAttributes": {
    "3000": { "label": "app" },
    "54321": { "label": "supabase api" },
    "54323": { "label": "supabase studio" },
    "54324": { "label": "mailpit" }
  },
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
  "postStartCommand": "bash .devcontainer/start-supabase.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "ms-playwright.playwright"]
    }
  }
}
